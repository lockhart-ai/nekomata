{
  "name": "nekomata",
  "displayName": "Nekomata",
  "description": "A pixel-art cat cafe that visualizes your running Claude Code sessions, subagents, and CPU/GPU/Docker load as cats.",
  "version": "1.2.1",
  "publisher": "lockhart-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lockhart-ai/nekomata.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "agents",
    "dashboard",
    "cats"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:nekomata.open",
    "onView:nekomata.view"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "nekomata",
          "title": "Nekomata",
          "icon": "media/cat.svg"
        }
      ]
    },
    "views": {
      "nekomata": [
        {
          "type": "webview",
          "id": "nekomata.view",
          "name": "Nekomata"
        }
      ]
    },
    "commands": [
      {
        "command": "nekomata.open",
        "title": "Nekomata: Open"
      }
    ],
    "configuration": {
      "title": "Nekomata",
      "properties": {
        "nekomata.style": {
          "type": "string",
          "enum": ["8bit", "16bit", "32bit"],
          "enumDescriptions": [
            "The original: flat, chunky cats on big pixels.",
            "Midway: the same chunky cats on a finer grid, with shading and smiles.",
            "Finer and cosier: outlined, shaded cats in a calm panelled room."
          ],
          "default": "8bit",
          "description": "The cafe's art style."
        },
        "nekomata.port": {
          "type": "number",
          "default": 8787,
          "description": "Port the Nekomata server listens on."
        },
        "nekomata.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python 3 interpreter used to run the bundled server."
        },
        "nekomata.serverScript": {
          "type": "string",
          "default": "",
          "description": "Override path to fleet_dashboard.py. Leave empty to use the copy bundled with the extension."
        }
      }
    }
  }
}
